-#ifndef __ILP32__
+#if !defined(__ILP32__) && !defined(LIBFFI_PS5)
 extern ffi_status
 ffi_prep_closure_loc_efi64(ffi_closure* closure,
 			   ffi_cif* cif,
@@ -773,7 +773,7 @@
   void (*dest)(void);
   char *tramp = closure->tramp;
 
-#ifndef __ILP32__
+#if !defined(__ILP32__) && !defined(LIBFFI_PS5)
   if (cif->abi == FFI_EFI64 || cif->abi == FFI_GNUW64)
