-#ifndef __ILP32__
+#if !defined(__ILP32__) && !defined(LIBFFI_PS5)
   if (cif->abi == FFI_EFI64 || cif->abi == FFI_GNUW64)
     {
       ffi_call_go_efi64(cif, fn, rvalue, avalue, closure);
@@ -744,7 +744,7 @@
 extern void ffi_closure_unix64_sse_alt(void) FFI_HIDDEN;
