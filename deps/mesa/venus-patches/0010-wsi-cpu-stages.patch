From: ps5wl contributors
Subject: [PATCH] wsi: forward diagnostic CPU presentation stages to Venus

--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -55,6 +55,8 @@
 #define VK_ICD_WSI_PLATFORM_MAX (VK_ICD_WSI_PLATFORM_METAL + 1)
 
 struct wsi_device {
+   /* Optional stage sink, installed before presentation worker startup. */
+   void (*trace_stage)(const char *stage);
    /* Allocator for the instance */
    VkAllocationCallbacks instance_alloc;
 
--- a/src/virtio/vulkan/vn_wsi.c
+++ b/src/virtio/vulkan/vn_wsi.c
@@ -119,6 +119,12 @@
    }
 }
 
+static void
+vn_wsi_trace_stage(const char *stage)
+{
+   vn_log(NULL, "sync-trace %s", stage);
+}
+
 static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
 vn_wsi_proc_addr(VkPhysicalDevice physicalDevice, const char *pName)
 {
@@ -186,6 +192,8 @@
    if (result != VK_SUCCESS)
       return result;
 
+   if (VN_DEBUG(WSI))
+      physical_dev->wsi_device.trace_stage = vn_wsi_trace_stage;
    physical_dev->wsi_device.supports_scanout = false;
    physical_dev->wsi_device.supports_modifiers =
       physical_dev->base.vk.supported_extensions.EXT_image_drm_format_modifier;
--- a/src/vulkan/wsi/wsi_common_private.h
+++ b/src/vulkan/wsi/wsi_common_private.h
@@ -43,6 +43,13 @@
 #define WSI_DEBUG_NOWLTS      (1ull << 5)
 
 extern uint64_t WSI_DEBUG;
+
+static inline void
+wsi_trace_stage(const struct wsi_device *wsi, const char *stage)
+{
+   if (wsi->trace_stage)
+      wsi->trace_stage(stage);
+}
 
 enum wsi_image_type {
    WSI_IMAGE_TYPE_CPU,
