#!/usr/bin/env python3
"""G1: in-process vkr threads, no-fd lavapipe, Venus Wayland shm presentation."""
import argparse
import os
from pathlib import Path
import re
import socket
import subprocess
import tempfile
import time
import vtest_protocol

ROOT = Path(__file__).resolve().parents[2]

def ready(path, process):
    end = time.monotonic() + 20
    while True:
        if process.poll() is not None or time.monotonic() > end:
            raise RuntimeError(f'{path}: server did not become ready')
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.connect(str(path))
            return
        except (ConnectionRefusedError, FileNotFoundError):
            time.sleep(.02)

def stop(p):
    if p.poll() is None:
        p.terminate()
    try:
        p.wait(timeout=10)
    except subprocess.TimeoutExpired:
        p.kill(); p.wait(); raise

def counts(pid):
    proc = Path('/proc') / str(pid)
    fds = list((proc/'fd').iterdir())
    shm_fds = 0
    for fd in fds:
        try:
            target = os.readlink(fd)
        except FileNotFoundError:
            # Client cleanup can close a descriptor after procfs lists it.
            continue
        shm_fds += 'vkr' in target or 'virgl' in target
    maps = [x for x in (proc/'maps').read_text().splitlines() if 'vkr' in x or 'virgl' in x]
    return shm_fds, len(maps)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--sanitize', action='store_true')
    parser.add_argument('--ps5-constraints', action='store_true',
                        help='128 MiB/context, two contexts, 1920x1080, 600 presents')
    parser.add_argument('--full-hd', action='store_true',
                        help='1920x1080, 600 presents with ordinary host quotas')
    parser.add_argument('--sync-trace', action='store_true',
                        help='Require queue-ring retirement and completed WSI trace stages')
    a = parser.parse_args()
    full_hd = a.full_hd or a.ps5_constraints
    if os.environ.get('PS5WL_BUILD_ENV') != '1':
        parser.error('run inside env/run')
    build = ROOT/'build/gpud'/('host-sanitize' if a.sanitize else 'host')
    mode = 'sanitize' if a.sanitize else 'host'
    mode += '-ps5' if a.ps5_constraints else '-full-hd' if full_hd else ''
    if a.sync_trace: mode += '-trace'
    logs = ROOT/'build/gpud/logs'/mode
    logs.mkdir(parents=True, exist_ok=True)
    subprocess.run([str(build/'memory-mask')], check=True)
    subprocess.run([str(build/'unix-listener-test')], check=True)
    with tempfile.TemporaryDirectory(prefix='gpud-', dir=ROOT/'build') as temp:
        runtime = Path(temp)
        env = dict(os.environ, XDG_RUNTIME_DIR=temp, WAYLAND_DISPLAY='gpud-wayland',
                   WLR_RENDERER='pixman', VN_DEBUG='vtest',
                   VTEST_SOCKET_NAME=str(runtime/'vtest'),
                   XKB_CONFIG_ROOT=str(ROOT/'build/host/sysroot/share/xkeyboard-config-2'),
                   LD_LIBRARY_PATH=str(ROOT/'build/host/sysroot/lib'),
                   PS5WL_NO_EXTERNAL_FD='true', ASAN_OPTIONS='abort_on_error=1:detect_leaks=1:fast_unwind_on_malloc=0',
                   UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1')
        if a.sync_trace:
            env.update(VN_DEBUG='vtest,wsi', MESA_LOG_LEVEL='debug')
        # Neither executable creates a child: Python is the external orchestrator.
        # Reproduce crash leftovers at both production listener entry points.
        for name in ('vtest', 'render'):
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stale:
                stale.bind(str(runtime/name))
        with (logs/'compositor.log').open('w') as cl, (logs/'server.log').open('w') as sl:
            compositor = subprocess.Popen([str(ROOT/'build/host/compositor/ps5wl'), '-b','headless','-d',env['WAYLAND_DISPLAY']], env=env, stdout=cl, stderr=cl)
            host_env = dict(env, PS5WL_VULKAN_LIBRARY=str(ROOT/'build/host/venus/lib/libvulkan_lvp.so'))
            server_args = [str(build/'gpud-host'), str(runtime/'vtest'), str(runtime/'render')]
            if a.ps5_constraints: server_args.append('--ps5-limits')
            server = subprocess.Popen(server_args, env=host_env, stdout=sl, stderr=sl)
            children = []
            try:
                ready(runtime/env['WAYLAND_DISPLAY'], compositor)
                ready(runtime/'vtest', server)
                vtest_protocol.run(runtime/'vtest')
                client_env = dict(env, PS5WL_VULKAN_LIBRARY=str(ROOT/'build/host/venus/lib/libvulkan_virtio.so'))
                cube = ROOT/'build/host/vkcube-venus/ps5wl-vkcube-venus'
                frames = 600 if full_hd else 120
                def launch(name, frames):
                    out = (logs/(name+'.log')).open('w')
                    args = [str(cube),'--wsi','wayland','--c',str(frames)]
                    if full_hd: args += ['--width','1920','--height','1080']
                    p = subprocess.Popen(args, env=client_env, stdout=out, stderr=out)
                    out.close(); children.append(p); return p
                def passed(p, name):
                    deadline = time.monotonic() + 120
                    while p.poll() is None:
                        if server.poll() is not None:
                            raise RuntimeError(f'GPU host exited={server.returncode}; see {logs}')
                        if time.monotonic() > deadline:
                            raise RuntimeError(f'{name}: timed out; see {logs}')
                        time.sleep(.02)
                    code = p.returncode
                    text = (logs/(name+'.log')).read_text()
                    if code or f'vkcube presented frame={frames}' not in text or f'vkcube exit frames={frames} validation_error=0' not in text:
                        raise RuntimeError(f'{name}: exit={code}; see {logs}')
                passed(launch('single',frames),'single')
                time.sleep(.2)
                baseline = counts(server.pid)
                victim = launch('killed',1000000)
                deadline = time.monotonic() + 30
                while 'vkcube presented frame=1' not in (logs/'killed.log').read_text():
                    if victim.poll() is not None or time.monotonic() > deadline:
                        raise RuntimeError('kill client failed before first frame')
                    time.sleep(.02)
                active = counts(server.pid)
                victim.kill(); victim.wait()
                deadline = time.monotonic() + 5
                after = counts(server.pid)
                while after != baseline and time.monotonic() < deadline:
                    time.sleep(.02); after = counts(server.pid)
                if active[1] <= baseline[1] or after != baseline:
                    raise RuntimeError(f'SHM cleanup failed baseline={baseline} active={active} after={after}')
                (logs/'cleanup.log').write_text(f'SHM fd,mapping baseline={baseline} active={active} after-kill={after}\n')
                one, two = launch('concurrent-1',frames), launch('concurrent-2',frames)
                passed(one,'concurrent-1'); passed(two,'concurrent-2')
            finally:
                for p in children:
                    if p.poll() is None: p.kill(); p.wait()
                if server.poll() is None:
                    (logs/'server-maps.log').write_text((Path('/proc')/str(server.pid)/'maps').read_text())
                stop(server); stop(compositor)
        server_text = (logs/'server.log').read_text()
        compositor_text = (logs/'compositor.log').read_text()
        if server.returncode or compositor.returncode:
            raise RuntimeError(f'server={server.returncode} compositor={compositor.returncode}')
        for marker in ['host-pointer blob:', 'Vulkan fd-export calls=0']:
            if marker not in server_text: raise RuntimeError('missing server evidence '+marker)
        for name in ('vtest', 'render'):
            if f'removed refused stale socket path={runtime/name}' not in server_text:
                raise RuntimeError('missing stale listener recovery '+name)
        if a.sync_trace:
            key = r'ctx=(\d+) ring=([1-9]\d*) fence=(\d+)'
            submitted = set(re.findall(r'sync-trace submit-begin '+key, server_text))
            completed = set(re.findall(r'sync-trace wait-end '+key+r' result=0', server_text))
            retired = set(re.findall(r'vtest sync-trace retire '+key, server_text))
            if not submitted & completed & retired:
                raise RuntimeError('missing completed nonzero queue-ring fence retirement chain')
            if 'vtest sync-trace wait-ready' not in server_text:
                raise RuntimeError('missing vtest wait-pipe completion trace')
            single_text = (logs/'single.log').read_text()
            for marker in ['sync-trace wsi-thread-start',
                           'sync-trace wsi-fence-wait-end result=0',
                           'sync-trace wsi-common-present-end result=0']:
                if marker not in single_text:
                    raise RuntimeError('missing completed client trace '+marker)
        dimensions = '1920x1080' if full_hd else '500x500'
        if 'Created shm allocator' not in compositor_text or f'client surface committed {dimensions} count={frames}' not in compositor_text:
            raise RuntimeError(f'missing {frames} compositor wl_shm commits at {dimensions}')
        for path in logs.glob('*.log'):
            text = path.read_text()
            if 'ERROR: AddressSanitizer' in text or 'runtime error:' in text or 'LeakSanitizer' in text:
                raise RuntimeError('sanitizer failure '+str(path))
        print(f'PASS: {frames} Venus shm frames; killed-client SHM baseline; concurrent clients; logs={logs}')

if __name__ == '__main__':
    main()
