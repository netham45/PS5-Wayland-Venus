 #include "vkr_device_memory_gen.h"
 #include "vkr_physical_device.h"
 
+
+#include "util/anon_file.h"
+#include <sys/mman.h>
+#include <unistd.h>
+
+static void
+vkr_shmem_release(int fd, void *ptr, uint64_t size)
+{
+   if (ptr)
+      munmap(ptr, size);
+   if (fd >= 0)
+      close(fd);
+}
+
+static VkResult
+vkr_shmem_import(struct vkr_device *dev, VkMemoryAllocateInfo *info,
+                  VkImportMemoryHostPointerInfoEXT *import, int *fd, void **ptr,
+                  uint64_t *size)
+{
+   struct vkr_physical_device *physical = dev->physical_device;
+   uint64_t alignment = MAX2(physical->min_imported_host_pointer_alignment,
+                             (uint64_t)getpagesize());
+   if (!alignment || (alignment & (alignment - 1)) ||
+       info->allocationSize > SIZE_MAX - alignment * 2)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   *size = (info->allocationSize + alignment - 1) & ~(alignment - 1);
+   *fd = os_create_anonymous_file(*size, "vkr-host-memory");
+   if (*fd < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   /* Reserve then replace only our own address space to meet host-import alignment. */
+   void *reserve = mmap(NULL, *size + alignment, PROT_NONE,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+   if (reserve == MAP_FAILED) {
+      vkr_shmem_release(*fd, NULL, 0);
+      *fd = -1;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   uintptr_t base = (uintptr_t)reserve;
+   uintptr_t aligned = (base + alignment - 1) & ~(alignment - 1);
+   void *mapping = mmap((void *)aligned, *size, PROT_READ | PROT_WRITE,
+                        MAP_SHARED | MAP_FIXED, *fd, 0);
+   if (mapping == MAP_FAILED) {
+      munmap(reserve, *size + alignment);
+      vkr_shmem_release(*fd, NULL, 0);
+      *fd = -1;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   if (aligned > base)
+      munmap(reserve, aligned - base);
+   if (base + *size + alignment > aligned + *size)
+      munmap((void *)(aligned + *size), base + alignment - aligned);
+   *ptr = mapping;
+
+   PFN_vkGetMemoryHostPointerPropertiesEXT get_props =
+      (PFN_vkGetMemoryHostPointerPropertiesEXT)physical->proc_table.GetDeviceProcAddr(
+         dev->base.handle.device, "vkGetMemoryHostPointerPropertiesEXT");
+   VkMemoryHostPointerPropertiesEXT props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+   };
+   VkResult result = get_props ? get_props(dev->base.handle.device,
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, *ptr, &props) :
+      VK_ERROR_EXTENSION_NOT_PRESENT;
+   if (result == VK_SUCCESS && !(props.memoryTypeBits & (1u << info->memoryTypeIndex)))
+      result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   if (result != VK_SUCCESS) {
+      vkr_shmem_release(*fd, *ptr, *size);
+      *fd = -1;
+      *ptr = NULL;
+      return result;
+   }
+   *import = (VkImportMemoryHostPointerInfoEXT){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .pNext = info->pNext,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = *ptr,
+   };
+   info->pNext = import;
+   info->allocationSize = *size;
+   return VK_SUCCESS;
+}
