+static int
+vkr_device_idle_thread(void *opaque)
+{
+   struct vkr_device_idle_check *check = opaque;
+   struct vkr_device *dev = check->dev;
    struct vn_device_proc_table *vk = &dev->proc_table;
    VkDevice device = dev->base.handle.device;
+   VkResult result = VK_SUCCESS;
+   uint32_t index = 0, pending = 0;
+   const VkFenceCreateInfo create_info = {
+      .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+   };
+
+   /* A fence submitted after every queue's existing work covers submissions
+    * without user fences and every preceding timeline signal/wait as well.
+    * Do not trust an early-success DeviceWaitIdle implementation on its own. */
+   list_for_each_entry (struct vkr_queue, queue, &dev->queues, base.track_head) {
+      result = vk->CreateFence(device, &create_info, NULL, &check->fences[index]);
+      if (result != VK_SUCCESS)
+         goto out;
+      mtx_lock(&queue->vk_mutex);
+      result = vk->QueueSubmit(queue->base.handle.queue, 0, NULL, check->fences[index]);
+      mtx_unlock(&queue->vk_mutex);
+      index++;
+      if (result != VK_SUCCESS)
+         goto out;
+   }
+
+   uint64_t start = vkr_device_now_ns();
+   vkr_log("teardown DeviceWaitIdle enter ctx=%u device=%p worker=%u queues=%u",
+           check->ctx_id, (void *)device, check->on_worker_thread, index);
+   result = vk->DeviceWaitIdle(device);
+   uint64_t end = vkr_device_now_ns();
+   vkr_log("teardown DeviceWaitIdle result=%d duration_ms=%" PRIu64 " ctx=%u",
+           result, start && end >= start ? (end - start) / UINT64_C(1000000) : 0,
+           check->ctx_id);
+   if (result != VK_SUCCESS)
+      goto out;
+
+   for (uint32_t i = 0; i < index; i++) {
+      result = vk->GetFenceStatus(device, check->fences[i]);
+      if (result != VK_SUCCESS) {
+         vkr_log("teardown queue sentinel not idle ctx=%u queue=%u result=%d",
+                 check->ctx_id, i, result);
+         goto out;
+      }
+   }
+   list_for_each_entry (struct vkr_queue, queue, &dev->queues, base.track_head) {
+      mtx_lock(&queue->sync_thread.mutex);
+      list_for_each_entry (struct vkr_queue_sync, sync, &queue->sync_thread.syncs, head) {
+         pending++;
+         result = sync->device_lost ? VK_ERROR_DEVICE_LOST
+                                   : vk->GetFenceStatus(device, sync->fence);
+         if (result != VK_SUCCESS)
+            break;
+      }
+      mtx_unlock(&queue->sync_thread.mutex);
+      if (result != VK_SUCCESS) {
+         vkr_log("teardown outstanding queue fence not idle ctx=%u result=%d",
+                 check->ctx_id, result);
+         goto out;
+      }
+   }
+   vkr_log("teardown idle verified ctx=%u queues=%u outstanding_fences=%u",
+           check->ctx_id, index, pending);
+   for (uint32_t i = 0; i < index; i++)
+      vk->DestroyFence(device, check->fences[i], NULL);
+out:
+   check->result = result;
+   atomic_store_explicit(&check->done, true, memory_order_release);
+   return 0;
+}
