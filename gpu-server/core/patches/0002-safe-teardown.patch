+bool
+vkr_device_wait_idle(struct vkr_context *ctx, struct vkr_device *dev)
+{
+   const char *reason = "GPU already wedged";
+   if (dev->idle_verified)
+      return true;
+   if (ctx->teardown_abandoned || gpud_is_wedged())
+      goto abandon;
+   uint32_t count = 0;
+   list_for_each_entry (struct vkr_queue, queue, &dev->queues, base.track_head)
+      count++;
+   struct vkr_device_idle_check *check =
+      calloc(1, sizeof(*check) + count * sizeof(check->fences[0]));
+   reason = "cannot allocate bounded idle check";
+   if (!check)
+      goto abandon;
+   dev->idle_check = check;
+   check->dev = dev;
+   check->ctx_id = ctx->ctx_id;
+   check->on_worker_thread = ctx->on_worker_thread;
+   atomic_init(&check->done, false);
+   reason = "cannot start bounded idle check";
+   if (thrd_create(&check->thread, vkr_device_idle_thread, check) != thrd_success)
+      goto abandon;
+
+   uint64_t start = vkr_device_now_ns(), now = start;
+   const struct timespec delay = { .tv_nsec = 1000000 };
+   while (!atomic_load_explicit(&check->done, memory_order_acquire)) {
+      now = vkr_device_now_ns();
+      if (!start || !now || now - start >= UINT64_C(2000000000))
+         break;
+      thrd_sleep(&delay, NULL);
+   }
+   if (!atomic_load_explicit(&check->done, memory_order_acquire)) {
+      thrd_detach(check->thread);
+      vkr_log("teardown idle timeout ctx=%u duration_ms=%" PRIu64 " bound_ms=2000",
+              ctx->ctx_id, start && now >= start ? (now - start) / UINT64_C(1000000) : 0);
+      reason = "device idle timeout (2000ms)";
+      goto abandon;
+   }
+   thrd_join(check->thread, NULL);
+   reason = "device or outstanding queue fence is not idle";
+   if (check->result != VK_SUCCESS)
+      goto abandon;
+   free(check);
+   dev->idle_check = NULL;
+   dev->idle_verified = true;
+   return true;
+abandon:
+   ctx->teardown_abandoned = true;
+   vkr_context_set_fatal(ctx);
+   gpud_mark_wedged(ctx->ctx_id, reason);
+   return false;
+}
