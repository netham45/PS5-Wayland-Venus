if(NOT DEFINED ENV{PS5_PAYLOAD_SDK})
  message(FATAL_ERROR "Source toolchain/env.sh first")
endif()
set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "")
if(EXISTS "${PS5_PAYLOAD_SDK}/toolchain/prospero.cmake")
  include("${PS5_PAYLOAD_SDK}/toolchain/prospero.cmake")
else()
  include("${PS5_PAYLOAD_SDK}/host/toolchain/prospero.cmake")
endif()
get_filename_component(PS5WL_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${PS5WL_ROOT}/cross/bin/prospero-clang" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${PS5WL_ROOT}/cross/bin/prospero-clang++" CACHE FILEPATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${PS5WL_ROOT}/build/ps5/sysroot" "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_INSTALL_PREFIX "${PS5WL_ROOT}/build/ps5/sysroot" CACHE PATH "" FORCE)
set(CMAKE_INSTALL_LIBDIR lib CACHE STRING "" FORCE)
set(PKG_CONFIG_EXECUTABLE "${CMAKE_CURRENT_LIST_DIR}/pkg-config" CACHE FILEPATH "" FORCE)
set(CMAKE_C_FLAGS_INIT "-I${PS5WL_ROOT}/build/ps5/sysroot/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${PS5WL_ROOT}/build/ps5/sysroot/lib")
